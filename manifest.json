{
  "manifest_version": 3,
  "name": "Acompanhamento de Contatos",
  "version": "1.0.0",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/*.js", "src/ui/*.js", "src/ui/*.html", "src/ui/styles/*.css", "icons/*"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ]
}
